# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Make every secret with:  openssl rand -base64 36

# Your domain (no https://, no www). Caddy also serves www.<DOMAIN> and redirects it here.
DOMAIN=clearpay4u.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Database password (letters and digits only keep it simple).
POSTGRES_PASSWORD=
# Signs login tokens. Changing it logs everyone out.
SECRET_KEY=
# Encrypts PAN and bank account numbers. Make it with:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# NEVER change or lose it: encrypted data cannot be read without it. Keep a copy in your password manager.
FIELD_ENCRYPTION_KEY=

# First platform admin, created on the first start only. Use a real mailbox and a strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payroll approval: true = a different admin must approve a run.
REQUIRE_SEPARATE_APPROVER=false

# Email via Amazon SES (Mumbai). SMTP credentials come from the SES console -> SMTP settings.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClearPay4U <no-reply@clearpay4u.com>

# 2 GB server: 2 API workers, 5 database connections each.
WEB_CONCURRENCY=2
DB_POOL_SIZE=5

# Backups: keep this many days of nightly database dumps on the server.
BACKUP_KEEP_DAYS=14
