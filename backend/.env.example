# Copy to .env (never commit .env). Leave DATABASE_URL empty to use in-memory storage.
DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payroll
# Throwaway database for the test suite - it is wiped on every test run.
TEST_DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payroll_test

# Signs login tokens. Use a long random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# First platform admin, created only when there are no users yet. Change the password after first login.
ADMIN_EMAIL=admin@clearpay4u.local
ADMIN_PASSWORD=ChangeMe123
